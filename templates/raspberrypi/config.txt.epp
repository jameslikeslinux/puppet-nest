<% case $facts['profile']['platform'] { -%>
<% 'raspberrypi': { -%>
enable_uart=1
uart_2ndstage=1
<% } -%>
<% 'raspberrypi5' : { -%>
dtoverlay=vc4-kms-v3d,cma-512
dtparam=pwr_led_trigger=actpwr
dtparam=uart0_console
<% } -%>
<% } -%>
<% case $nest::bootloader { -%>
<% 'systemd': { -%>
kernel=u-boot.bin
<% } -%>
<% 'u-root': { -%>
initramfs u-root.img followkernel
<% } -%>
<% } -%>
<% $nest::raspberrypi_config.each |$line| { -%>
<%= $line %>
<% } -%>
