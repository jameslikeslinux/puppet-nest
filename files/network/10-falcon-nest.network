[Match]
Host=falcon
Name=br0

[Network]
Address=172.22.4.2/24
DNS=172.22.4.3
DNS=172.22.4.1
# Keep the uplink resolver available to kubelet's non-stub resolv.conf
DNSDefaultRoute=yes
DNSSEC=no
# Private suffixes use the separate Kestrel-only resolver scope.
Domains=~.

[Route]
Destination=172.22.0.0/24
Gateway=172.22.4.3
