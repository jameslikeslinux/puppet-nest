# Trusted Nest source, never built from Luna's application checkout/image.
FROM registry.gitlab.joyfullee.me/nest/tools/agent@sha256:820cc8a130309a07db90685958bb9cac87d8376ab63f2d45457e87431ad93e34

# No live credential, kubeconfig or private generation is in the build context.
# Exact transitive versions, binary wheels only; no application dependency hooks.
RUN python3 -m venv /opt/joyride-evidence/venv && \
    /opt/joyride-evidence/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check --only-binary=:all: \
    cryptography==50.0.2 cffi==2.1.1 pycparser==3.11
COPY installed_test_producer.py installed_test_probes.py evidence_key.py /opt/joyride-evidence/source/
COPY evidence_runtime.py /opt/joyride-evidence/runtime.py
RUN chmod -R go-w /opt/joyride-evidence && \
    chmod 0555 /opt/joyride-evidence/source && \
    chmod 0444 /opt/joyride-evidence/source/*.py /opt/joyride-evidence/runtime.py

ENV PATH=/opt/joyride-evidence/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/scratch GLAB_CONFIG_DIR=/credentials/gitlab KUBECONFIG=/credentials/kubeconfig \
    TMPDIR=/scratch PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/joyride-evidence
ENTRYPOINT ["/opt/joyride-evidence/venv/bin/python", "-I", "-B", "/opt/joyride-evidence/runtime.py"]
