[Unit]
Description=Isolated Joyride CI rootless Podman API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=joyride-ci
Group=joyride-ci
Environment=HOME=/var/lib/joyride-ci
Environment=XDG_RUNTIME_DIR=/run/joyride-ci
Environment=TMPDIR=/var/lib/joyride-ci/tmp
RuntimeDirectory=joyride-ci
RuntimeDirectoryMode=0700
Delegate=yes
UMask=0077
ExecStart=/usr/bin/podman --cgroup-manager=cgroupfs system service --time=0 unix:///run/joyride-ci/podman.sock
ExecStartPost=/usr/bin/timeout 30 /bin/sh -c 'until test -S /run/joyride-ci/podman.sock; do sleep 0.1; done'
Restart=on-failure
RestartSec=5
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# Netavark must start DNS in this service, not a nonexistent user manager.
# Omit the sd_booted marker; retain only systemd-resolved's resolver files.
TemporaryFileSystem=/run/systemd:ro
BindReadOnlyPaths=-/run/systemd/resolve
InaccessiblePaths=-/etc/eyaml -/etc/puppetlabs/bolt -/etc/puppetlabs/puppet -/etc/joyride-ci -/etc/gemrc -/srv/gitlab-runner -/var/lib/joyride-evidence -/run/podman -/run/user
ReadWritePaths=/var/lib/joyride-ci /run/joyride-ci
# newuidmap/newgidmap must be allowed to establish the subordinate namespace.
# NoNewPrivileges would prevent that; it is not an isolation substitute.

[Install]
WantedBy=multi-user.target
