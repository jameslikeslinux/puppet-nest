#!/usr/bin/env python3
"""Bind config executor members to this CI pipeline; never authorize an OS rollout."""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys

CPUS = ("haswell", "cortex-a53", "sifive-u74")
FIELDS = {"schema", "kind", "project", "sha", "pipeline", "job", "cpu", "image", "source_verification", "inputs"}


def require(condition):
    if not condition:
        raise ValueError("invalid executor identity or incomplete pipeline members")


def context():
    sha = os.environ.get("CI_COMMIT_SHA", "")
    require(re.fullmatch(r"[0-9a-f]{40}", sha) is not None)
    require(os.environ.get("CI_PROJECT_PATH") == "nest/config")
    pipeline = os.environ.get("CI_PIPELINE_ID", "")
    require(re.fullmatch(r"[1-9][0-9]{0,19}", pipeline) is not None)
    repo = os.environ.get("CI_REGISTRY_IMAGE", "") + "/" + os.environ.get("CI_COMMIT_REF_SLUG", "")
    require(re.fullmatch(r"[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+", repo) is not None)
    return sha, int(pipeline), repo


def validate(row, cpu, expected_context=None):
    sha, pipeline, repo = context() if expected_context is None else expected_context
    require(type(row) is dict and set(row) == FIELDS)
    require(type(row["schema"]) is int and row["schema"] == 2 and row["kind"] == "nest_config_executor_member")
    require(row["project"] == "nest/config" and row["sha"] == sha)
    require(type(row["pipeline"]) is int and row["pipeline"] == pipeline)
    require(type(row["job"]) is int and 0 < row["job"] < 10 ** 20)
    require(cpu in CPUS and row["cpu"] == cpu)
    require(type(row["image"]) is str and re.fullmatch(re.escape(repo) + r"@sha256:[0-9a-f]{64}", row["image"]) is not None)
    require(row["source_verification"] == "git_head_and_oci_revision")
    inputs = row["inputs"]
    require(type(inputs) is dict and set(inputs) == {"schema", "kind", "source", "base_image", "puppetfile_digest", "modules"})
    require(type(inputs["schema"]) is int and inputs["schema"] == 1
            and inputs["kind"] == "nest_config_executor_inputs" and inputs["source"] == sha)
    require(type(inputs["base_image"]) is str and re.fullmatch(r"[a-z0-9][a-z0-9.:-]*(/[a-z0-9][a-z0-9._-]*)+@sha256:[0-9a-f]{64}", inputs["base_image"]) is not None)
    require(type(inputs["puppetfile_digest"]) is str and re.fullmatch(r"sha256:[0-9a-f]{64}", inputs["puppetfile_digest"]) is not None)
    require(type(inputs["modules"]) is list and 6 <= len(inputs["modules"]) <= 128)
    names = set()
    for module in inputs["modules"]:
        require(type(module) is dict and set(module) == {"name", "git_head", "content_digest"})
        name = module["name"]
        require(type(name) is str and re.fullmatch(r"[a-z][a-z0-9_]*", name) is not None and name not in names)
        names.add(name)
        require(type(module["content_digest"]) is str and re.fullmatch(r"sha256:[0-9a-f]{64}", module["content_digest"]) is not None)
        require(module["git_head"] is None or (type(module["git_head"]) is str and re.fullmatch(r"[0-9a-f]{40}", module["git_head"]) is not None))
        require(name != "nest" or module["git_head"] == sha)
    require({"nest", "stdlib", "reboot", "ruby_task_helper", "private", "kubecm"} <= names)
    return row


def command(args, phase, timeout=180):
    # Static phase labels only: never expose captured registry/credential errors.
    print("Executor verification: " + phase, file=sys.stderr, flush=True)
    try:
        return subprocess.run(args, check=True, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except subprocess.TimeoutExpired:
        print("Executor verification timed out: " + phase, file=sys.stderr, flush=True)
        raise


def record(reference_path, output):
    sha, pipeline, _ = context()
    cpu = os.environ.get("CPU", "")
    job = os.environ.get("CI_JOB_ID", "")
    require(re.fullmatch(r"[1-9][0-9]{0,19}", job) is not None)
    raw = Path(reference_path).read_bytes()
    require(len(raw) <= 1024 and raw.endswith(b"\n") and raw.count(b"\n") == 1)
    reference = raw[:-1].decode("ascii")
    require(cpu in CPUS and re.fullmatch(re.escape(context()[2]) + r"@sha256:[0-9a-f]{64}", reference) is not None)
    # The recorded base is read from this digest image, then every module is
    # rehashed there. No mounted checkout or submitted module list is trusted.
    # A slow pull/unpack must not consume the bounded offline content-check
    # budget. Still pull this exact published digest, never trust a local tag.
    command(["podman", "pull", reference], "pull published digest", timeout=600)
    # Podman's automatic read-only tmpfs copy-up can copy image /tmp build
    # residue before the verifier even starts. Neither check needs writable
    # temporary storage; keep those image paths read-only as well.
    inputs_command = ["podman", "run", "--rm", "--pull=never", "--network=none", "--read-only", "--read-only-tmpfs=false",
                      "--cap-drop=ALL", "--security-opt=no-new-privileges", "--entrypoint=python3", reference,
                      "-c", "import json,subprocess; p='/opt/nest'; r=json.load(open(p+'/.executor-inputs.json')); subprocess.run(['python3',p+'/scripts/nest-executor-inputs.py','check','--source',r['source'],'--base',r['base_image']],check=True)"]
    raw_inputs = command(inputs_command, "check installed inputs")
    require(len(raw_inputs) <= 65536)
    inputs = json.loads(raw_inputs, object_pairs_hook=unique)
    row = validate({"schema": 2, "kind": "nest_config_executor_member", "project": "nest/config", "sha": sha,
                    "pipeline": pipeline, "job": int(job), "cpu": cpu, "image": reference,
                    "source_verification": "git_head_and_oci_revision", "inputs": inputs}, cpu)
    # No host mounts, network, build plan, or secret environment in the container.
    require(command(["podman", "run", "--rm", "--pull=never", "--network=none", "--read-only", "--read-only-tmpfs=false",
                     "--cap-drop=ALL", "--security-opt=no-new-privileges", "--entrypoint=git", reference,
                     "-C", "/opt/nest", "rev-parse", "HEAD"], "check Git source") == sha)
    require(command(["podman", "image", "inspect", reference, "--format",
                     '{{ index .Labels "org.opencontainers.image.revision" }}'], "check OCI source") == sha)
    payload = (json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii")
    # A private CI workspace, not a shared publication service. Never replace a receipt.
    with open(output, "xb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())
    require(Path(output).read_bytes() == payload)


def unique(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result)
        result[key] = value
    return result


def references(directory):
    rows = []
    for cpu in CPUS:
        with open(Path(directory) / (cpu + ".json"), "rb") as stream:
            raw = stream.read(65537)
        require(len(raw) <= 65536)
        rows.append(validate(json.loads(raw, object_pairs_hook=unique), cpu))
    require(len({row["job"] for row in rows}) == len(CPUS))
    require(len({row["image"] for row in rows}) == len(CPUS))
    # Print only after the complete exact-pipeline set is validated.
    return "\n".join(row["image"] for row in rows)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="action", required=True)
    one = sub.add_parser("record")
    one.add_argument("reference_path")
    one.add_argument("output")
    all_members = sub.add_parser("refs")
    all_members.add_argument("directory")
    args = parser.parse_args()
    try:
        if args.action == "record":
            record(args.reference_path, args.output)
        else:
            print(references(args.directory))
        return 0
    except (OSError, ValueError, TypeError, RecursionError, subprocess.SubprocessError):
        # Never echo subprocess stderr, submitted metadata, paths, or CI credentials.
        print("Executor identity verification failed; no accepted member set emitted", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
